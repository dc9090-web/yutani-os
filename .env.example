# EVE SSO application (developers.eveonline.com). Callback: https://<your domain>/auth/callback,
# or http://localhost:3000/auth/callback for local development.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:3000/auth/callback

# Google sign-in (Google Cloud OAuth client, type Web application). Redirect URI:
# https://<your domain>/auth/google/callback, or http://localhost:3000/auth/google/callback locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in: comma-separated Google account emails. Empty stops the app from starting.
ALLOWED_GOOGLE_EMAILS=
# Shown on the Overview page and the Skills training overview; empty = all characters.
OVERVIEW_CHARACTER_IDS=
# Your initials for the account button in the header (up to three letters); empty shows a person icon.
OWNER_INITIALS=

# ESI. The compatibility date must be one ESI publishes; the user agent needs a contact (CCP asks).
ESI_COMPATIBILITY_DATE=2026-08-18
ESI_USER_AGENT=YutaniOS/0.1 (you@example.com)

# App
SESSION_SECRET=
DATABASE_URL=postgres://eve:eve@127.0.0.1:5432/eve
POSTGRES_PASSWORD=eve
