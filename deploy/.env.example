# Production stack. deploy/setup.sh + Ansible template the real file from vars/site.yml and
# vars/secrets.yml; this is what it ends up looking like.
APP_DOMAIN=eve.example.com
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=https://eve.example.com/auth/callback
ALLOWED_CHARACTER_IDS=
OVERVIEW_CHARACTER_IDS=
ESI_COMPATIBILITY_DATE=2026-08-18
ESI_USER_AGENT=YutaniOS/0.1 (you@example.com; +https://eve.example.com)
SESSION_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://eve:<POSTGRES_PASSWORD>@postgres:5432/eve
NODE_ENV=production
