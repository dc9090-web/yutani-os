---
# deploy/setup.sh writes vars/secrets.yml for you (mode 0600). Never commit the real file.
cloudflare_dns_api_token: "CHANGEME"   # Zone → DNS → Edit on the zone that holds the domain
eve_client_id: "CHANGEME"              # developers.eveonline.com application
eve_client_secret: "CHANGEME"
session_secret: "CHANGEME"             # openssl rand -hex 32
postgres_password: "CHANGEME"          # openssl rand -hex 16
